# SecureLambda API Configuration
# This file is sourced by docker-compose.yml as env_file for api and worker services.
# For local development on-host (not in Docker), adjust DATABASE_URL, REDIS_URL, and
# STORAGE_ENDPOINT to use localhost instead of service hostnames. docker-compose.yml's
# environment: section overrides these values when running in containers.

# Node environment (development, test, production)
NODE_ENV=development

# API server port
PORT=3000

# ======== Database ========
# PostgreSQL connection string. For local development on-host: localhost:5432
# For docker-compose: postgres:5432 (service hostname)
DATABASE_URL=postgres://securelambda:securelambda@localhost:5432/securelambda

# ======== Cache ========
# Redis connection string. For local development on-host: localhost:6379
# For docker-compose: redis:6379 (service hostname)
REDIS_URL=redis://localhost:6379

# ======== Object Storage (MinIO) ========
# S3-compatible storage endpoint. For local development on-host: localhost:9000
# For docker-compose: minio:9000 (service hostname, internal API port)
STORAGE_ENDPOINT=http://localhost:9000

# MinIO root user (default from docker-compose.yml)
STORAGE_ACCESS_KEY=securelambda

# MinIO root password (default from docker-compose.yml)
STORAGE_SECRET_KEY=securelambda123

# S3 bucket name for asset storage
STORAGE_BUCKET=securelambda-assets

# S3 region (affects bucket location and CORS headers). Use "auto" for Cloudflare R2.
STORAGE_REGION=us-east-1

# (Optional) Folder inside the bucket, so a shared bucket (e.g. Cloudflare R2) stays tidy.
STORAGE_KEY_PREFIX=

# ======== NEAR Blockchain (x402 payment integration) ========
# RPC endpoint for NEAR testnet (used to verify payment transactions and call contracts)
NEAR_RPC_URL=https://test.rpc.fastnear.com

# NEAR network name (testnet or mainnet; used for tx validation)
NEAR_NETWORK=testnet

# (Optional) Relayer account ID on NEAR (e.g., relayer.testnet) for x402 quotes.
# If omitted, the API runs in "buyer-pays-direct" mode (buyer signs transactions).
RELAYER_ACCOUNT=

# (Optional) Relayer private key in NEAR format (ed25519:<base58>); needed for FACILITATOR_MODE=near.
# The relayer pays gas when settling. It does NOT fund payments (the buyer's tokens do).
RELAYER_KEY=

# sandbox = Redis ledger, no chain (default). near = real NEP-366 payments settled on NEAR.
FACILITATOR_MODE=sandbox

# NEP-141 token buyers pay in. Required when FACILITATOR_MODE=near. wNEAR on testnet:
PAYMENT_TOKEN_CONTRACT=

# Worker only. Who scores a run:
#   mock     canned metrics (default, used by tests)
#   local    the real Rust evaluator on this machine; real maths but not in an enclave, never reported as attested
#            (also needs EVALUATOR_BIN, EVALUATOR_PRIVATE_KEY, EVALUATOR_WASM_HASH)
#   outlayer the real evaluator in OutLayer's TEE, through NEAR (needs the four OUTLAYER_* values below)
EVALUATOR_MODE=mock

# EVALUATOR_MODE=outlayer: the deployed OutLayer project ("owner/name"), the account that signs and pays for
# requests (use a dedicated sub-account) with its `ed25519:...` key, and the account that stored the project's
# EVALUATOR_PRIVATE_KEY secret (defaults to the project owner). Optional: OUTLAYER_CONTRACT (outlayer.testnet),
# OUTLAYER_MAX_SECONDS (10).
OUTLAYER_PROJECT=
OUTLAYER_SIGNER_ACCOUNT=
OUTLAYER_SIGNER_KEY=
OUTLAYER_SECRETS_ACCOUNT=

# ======== Payment Configuration ========
# Asset for payment: 'near' (default) for NEAR native tokens, or 'usdc' for USDC bridge.
# Per the architecture, NEAR native is the default; USDC is configurable.
PAYMENT_ASSET=near

# Payment quote validity window (minutes)
PAYMENT_VALID_MINUTES=15

# ======== Upload Limits ========
# Maximum size (bytes) for a single dataset or model upload (default 1 MB)
MAX_UPLOAD_BYTES=1048576

# ======== Access Control ========
# Comma-separated list of NEAR account IDs allowed to use seller routes (POST /listings).
# If empty, no account can create listings.
# Example: seller.testnet,alice.testnet,bob.testnet
SELLER_ALLOW_LIST=

# ======== Rate Limiting ========
# Maximum API requests per IP per minute (default 60)
RATE_LIMIT_PER_IP_PER_MINUTE=60

# ======== Auth (NEP-413 signed login) ========
# "signed" (default): callers log in with a NEAR signature and send Authorization: Bearer <session>.
# "header": trusts a client-supplied x-account-id. Local development only; refused when NODE_ENV=production.
AUTH_MODE=signed
# The recipient a login signature must be made for.
AUTH_AUDIENCE=securelambda-api
AUTH_SESSION_TTL_SECONDS=3600
AUTH_CHALLENGE_TTL_SECONDS=300

