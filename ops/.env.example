# SecureLambda API Configuration
# This file is sourced by docker-compose.yml as env_file for api and worker services.
# For local development on-host (not in Docker), adjust DATABASE_URL, REDIS_URL, and
# STORAGE_ENDPOINT to use localhost instead of service hostnames. docker-compose.yml's
# environment: section overrides these values when running in containers.

# Node environment (development, test, production)
NODE_ENV=development

# API server port
PORT=3000

# ======== Database ========
# PostgreSQL connection string. For local development on-host: localhost:5432
# For docker-compose: postgres:5432 (service hostname)
DATABASE_URL=postgres://securelambda:securelambda@localhost:5432/securelambda

# ======== Cache ========
# Redis connection string. For local development on-host: localhost:6379
# For docker-compose: redis:6379 (service hostname)
REDIS_URL=redis://localhost:6379

# ======== Object Storage (MinIO) ========
# S3-compatible storage endpoint. For local development on-host: localhost:9000
# For docker-compose: minio:9000 (service hostname, internal API port)
STORAGE_ENDPOINT=http://localhost:9000

# MinIO root user (default from docker-compose.yml)
STORAGE_ACCESS_KEY=securelambda

# MinIO root password (default from docker-compose.yml)
STORAGE_SECRET_KEY=securelambda123

# S3 bucket name for asset storage
STORAGE_BUCKET=securelambda-assets

# S3 region (affects bucket location and CORS headers)
STORAGE_REGION=us-east-1

# ======== NEAR Blockchain (x402 payment integration) ========
# RPC endpoint for NEAR testnet (used to verify payment transactions and call contracts)
NEAR_RPC_URL=https://rpc.testnet.near.org

# NEAR network name (testnet or mainnet; used for tx validation)
NEAR_NETWORK=testnet

# (Optional) Relayer account ID on NEAR (e.g., relayer.testnet) for x402 quotes.
# If omitted, the API runs in "buyer-pays-direct" mode (buyer signs transactions).
RELAYER_ACCOUNT=

# (Optional) Base64-encoded relayer private key (needed only if RELAYER_ACCOUNT is set).
# Must be a valid NEAR Ed25519 private key. If omitted, relayer is disabled.
RELAYER_KEY=

# (Optional) OutLayer project name/ID for TEE evaluator attestation.
# Used to verify attestation quotes from the OutLayer enclave.
OUTLAYER_PROJECT=

# ======== Payment Configuration ========
# Asset for payment: 'near' (default) for NEAR native tokens, or 'usdc' for USDC bridge.
# Per the architecture, NEAR native is the default; USDC is configurable.
PAYMENT_ASSET=near

# Payment quote validity window (minutes)
PAYMENT_VALID_MINUTES=15

# ======== Upload Limits ========
# Maximum size (bytes) for a single dataset or model upload (default 1 MB)
MAX_UPLOAD_BYTES=1048576

# ======== Access Control ========
# Comma-separated list of NEAR account IDs allowed to use seller routes (POST /listings).
# If empty, all accounts can create listings (no allowlist enforced).
# Example: seller.testnet,alice.testnet,bob.testnet
SELLER_ALLOW_LIST=

# ======== Rate Limiting ========
# Maximum API requests per IP per minute (default 60)
RATE_LIMIT_PER_IP_PER_MINUTE=60
