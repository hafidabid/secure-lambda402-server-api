{
  "name": "@securelambda/mcp-server",
  "version": "0.1.1",
  "description": "MCP server that lets Claude Code, Claude Desktop and Codex browse SecureLambda listings and pay per evaluation run on NEAR testnet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hafidabid/secure-lambda402-server-api.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "claude",
    "codex",
    "near",
    "x402",
    "tee"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "securelambda-mcp": "bundle/index.js"
  },
  "files": [
    "bundle",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "lint": "echo no-op",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bundle/index.js --external:bufferutil --external:utf-8-validate --log-level=warning",
    "prepublishOnly": "cd ../.. && npm run build:libs && cd packages/mcp-server && npm run bundle"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@near-js/crypto": "^1.4.2",
    "@securelambda/agent-sdk": "0.1.0",
    "@securelambda/schemas": "0.1.0",
    "zod": "^3.25.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "esbuild": "0.24.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
